{
	"name": "@pdfcraft/core",
	"version": "8.0.0",
	"description": "PDFCraft document-definition and PDF generation core for Node.js",
	"type": "module",
	"sideEffects": false,
	"author": "kljws",
	"license": "MIT",
	"homepage": "https://github.com/kljws/pdfcraft#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kljws/pdfcraft.git",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/kljws/pdfcraft/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"pdf",
		"javascript",
		"printing",
		"layout"
	],
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.build.json",
		"build": "pnpm run typecheck && tsdown",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"linebreak": "^1.1.0",
		"pdfkit": "^0.20.2"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@types/pdfkit": "^0.17.5",
		"tsdown": "^0.22.9",
		"typescript": "^7.0.2"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": "./dist/index.mjs"
		},
		"./adapter": {
			"import": {
				"types": "./dist/adapter.d.mts",
				"default": "./dist/adapter.mjs"
			},
			"require": {
				"types": "./dist/adapter.d.cts",
				"default": "./dist/adapter.cjs"
			}
		},
		"./types": {
			"types": "./dist/types.d.ts"
		},
		"./package.json": "./package.json"
	}
}
