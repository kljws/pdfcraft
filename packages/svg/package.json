{
	"name": "@pdfcraft/svg",
	"version": "8.0.0",
	"description": "SVG extension for PDFCraft",
	"type": "module",
	"sideEffects": false,
	"author": "kljws",
	"license": "MIT",
	"homepage": "https://github.com/kljws/pdfcraft#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kljws/pdfcraft.git",
		"directory": "packages/svg"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.build.json",
		"build": "pnpm run typecheck && tsdown",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"xmldoc": "^3.0.0"
	},
	"devDependencies": {
		"@pdfcraft/core": "workspace:^",
		"tsdown": "^0.22.9",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"@pdfcraft/core": "^8.0.0"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	}
}
